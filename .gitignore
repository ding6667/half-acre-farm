# ======================
# Cocos Creator 3.8.x 专用忽略规则
# ======================
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
*.log
*.swp
*.swo

# ======================
# Cocos Creator 3.8.x 核心忽略
# ======================
library/
temp/
build/
local/
packages/
creator.d.ts
.creator/
.editor/
.meta-cache/

# ======================
# 开发依赖/编译产物
# ======================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# ======================
# TypeScript 编译产物
# ======================
*.js
*.js.map
*.d.ts.bak
!assets/**/*.js
!assets/**/*.js.map
!assets/**/*.d.ts
!extensions/**/*.js
!extensions/**/*.js.map
!extensions/**/*.d.ts

# ======================
# 发布/测试相关
# ======================
publish/
release/
build-report.html
build-report.json
remote-debugger.log